# Copy to .env and fill in. .env is gitignored; never commit real values.
# Loaded by Node itself: npm run dev / npm run migrate use --env-file=.env

# Claude API (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# AWS (credentials come from `aws login --profile se4458`, not from this file)
AWS_PROFILE=se4458
AWS_REGION=eu-north-1

# development (default) or production; ECS sets production. The public dev JWT_SECRET
# below is refused in production.
APP_ENV=development

# Local database and cache (docker compose). Production values point at RDS / ElastiCache.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=billing
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing_local_dev
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing secret (the server's private key for login tokens), 32+ characters.
# The value below is PUBLIC and only works while the database is local: the app refuses
# to start with any "local-dev-only-" key against a remote database such as RDS.
# For anything deployed, generate a private one and keep it in Secrets Manager:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
JWT_SECRET=local-dev-only-public-key-do-not-deploy-5f3a91c2

# Demo login passwords for `npm run seed`. These are PUBLIC on purpose: the accounts
# (ayse / mehmet) are fictitious demo users with fake bills, for the instructor to log in.
# Never reuse them for anything real.
SEED_PASSWORD_AYSE=Demo-Ayse-2025
SEED_PASSWORD_MEHMET=Demo-Mehmet-2025
# The provider's demo system key (X-API-Key: records usage, calculates any bill). Also public.
# For a real key: node -e 'console.log("pk_" + require("crypto").randomBytes(32).toString("base64url"))'
SEED_PROVIDER_API_KEY=pk_demo-provider-key-public-do-not-deploy-7f3c2a91
