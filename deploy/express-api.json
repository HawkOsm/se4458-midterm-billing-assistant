{
  "serviceName": "billing-api",
  "cluster": "default",
  "executionRoleArn": "arn:aws:iam::860897619048:role/ecsTaskExecutionRole",
  "infrastructureRoleArn": "arn:aws:iam::860897619048:role/ecsInfrastructureRoleForExpressServices",
  "primaryContainer": {
    "image": "860897619048.dkr.ecr.eu-north-1.amazonaws.com/billing-assistant:b233fe8",
    "containerPort": 8080,
    "command": ["node", "dist/index.js"],
    "environment": [
      { "name": "APP_ENV", "value": "production" },
      { "name": "PORT", "value": "8080" },
      { "name": "POSTGRES_HOST", "value": "billing-db.cn66iuysyail.eu-north-1.rds.amazonaws.com" },
      { "name": "POSTGRES_DB", "value": "billing" },
      { "name": "POSTGRES_USER", "value": "billing" },
      { "name": "POSTGRES_SSL", "value": "true" }
    ],
    "secrets": [
      { "name": "POSTGRES_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-north-1:860897619048:secret:billing/db-password-IC5l6q" },
      { "name": "JWT_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:860897619048:secret:billing/jwt-secret-4VSZjd" },
      { "name": "GATEWAY_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-north-1:860897619048:secret:billing/gateway-secret-Fseu8W" }
    ]
  },
  "healthCheckPath": "/health",
  "cpu": "256",
  "memory": "512",
  "scalingTarget": { "minTaskCount": 1, "maxTaskCount": 1 },
  "tags": [{ "key": "project", "value": "se4458-billing" }]
}
